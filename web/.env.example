# ---- Database (Postgres) ----
# Local dev: postgresql://USER:PASSWORD@localhost:5432/restaurant_db
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/restaurant_db?schema=public"

# ---- Auth.js / NextAuth v5 ----
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Base URL of the app (used by Auth.js callbacks)
AUTH_URL="http://localhost:3000"

# ---- Customer QR table tokens (HMAC) ----
# Generate with: openssl rand -hex 32
TABLE_SECRET_KEY=""

# ---- Stripe (billing + customer payments) — added in Phase 7/8 ----
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
