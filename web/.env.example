# ---- Database (Postgres) ----
# Local dev: postgresql://USER:PASSWORD@localhost:5432/restaurant_db
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/restaurant_db?schema=public"

# ---- Auth.js / NextAuth v5 ----
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Base URL of the app (used by Auth.js callbacks)
AUTH_URL="http://localhost:3000"

# ---- Customer QR table tokens (HMAC) ----
# Generate with: openssl rand -hex 32
TABLE_SECRET_KEY=""

# ---- Stripe (restaurant subscription billing) ----
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# The recurring price the restaurant subscribes to (price_...).
STRIPE_PRICE_ID=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Free-trial length for new subscriptions, in days (default 7; 0 disables).
STRIPE_TRIAL_DAYS="7"
